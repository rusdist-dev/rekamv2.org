# CMS Publik — cms.rekam.org. Lihat docs/api-public.md untuk kontrak lengkap.
# Key didapat dari Pengaturan Situs > API Key di dashboard CMS (super admin saja).
BASE_URL_CMS="https://cms.rekam.org"
X_API_KEY=""

# Domain publik build ini — satu-satunya tempat domain situs ditulis.
# Dipakai canonical, Open Graph, sitemap, robots, dan tautan yang dibagikan
# tombol share di halaman berita (src/lib/site.ts).
#
# Isi dengan domain tempat build ini BENAR-BENAR dilayani, bukan domain tujuan:
# selama situs masih di v2.rekam.org, tautan yang dibagikan ke Facebook/X/
# WhatsApp harus menunjuk ke sana, bukan ke situs lama di rekam.org.
# Ganti ke https://rekam.org saat pindah domain.
#
# NEXT_PUBLIC_* di-inline saat build, bukan dibaca saat runtime — mengubah
# nilai ini perlu build ulang dan deploy ulang, bukan sekadar restart.
NEXT_PUBLIC_SITE_URL="https://v2.rekam.org"
